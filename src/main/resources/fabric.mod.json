{
  "schemaVersion": 1,
  "id": "simplefabriccustomskin",
  "version": "${version}",
  "name": "SimpleFabricCustomSkin",
  "description": "Simple server skin assignment from local skins folder.",
  "authors": ["anthony17j"],
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.gmail.anthony17j.simplefabriccustomskin.SimpleFabricCustomSkin"
    ]
  },
  "mixins": [
    "simplefabriccustomskin.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
